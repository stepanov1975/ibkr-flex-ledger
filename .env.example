POSTGRES_DB=stock_app
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_PORT=5433

ENVIRONMENT_NAME=development
APPLICATION_HOST=0.0.0.0
APPLICATION_PORT=8000
# Host-shell commands use this URL. Docker Compose overrides DATABASE_URL for
# the app container with the `postgres:5432` service address.
# Use this when running commands from host shell (alembic, pytest, python -m app.main)
DATABASE_URL=postgresql+psycopg://stock_user:stock_password@127.0.0.1:5433/stock_app
ACCOUNT_ID=U123456
IBKR_FLEX_TOKEN=compose-placeholder-token
IBKR_FLEX_QUERY_ID=compose-placeholder-query
API_DEFAULT_LIMIT=50
API_MAX_LIMIT=200
